<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.DianyingleixingDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.DianyingleixingEntity" id="dianyingleixingMap">
        <result property="dianyingleixing" column="dianyingleixing"/>
    </resultMap>

    <sql id="legacyMovieTypeColumns">
        COALESCE(t.legacy_dianyingleixing_id, t.id) AS id,
        t.type_name AS dianyingleixing,
        t.created_at AS addtime
    </sql>

	<select id="selectListVO"
		resultType="com.entity.vo.DianyingleixingVO" >
		SELECT <include refid="legacyMovieTypeColumns"/> FROM app_movie_type t
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.DianyingleixingVO" >
		SELECT <include refid="legacyMovieTypeColumns"/> FROM app_movie_type t
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.DianyingleixingView" >

		SELECT <include refid="legacyMovieTypeColumns"/> FROM app_movie_type t
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.DianyingleixingView" >
		SELECT <include refid="legacyMovieTypeColumns"/> FROM app_movie_type t <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	


</mapper>
