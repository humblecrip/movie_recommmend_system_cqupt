<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.AppAdminUserSessionDao">

    <select id="selectIdByLegacyUsersId" resultType="java.lang.Long">
        SELECT id
        FROM app_admin_user
        WHERE legacy_users_id = #{legacyUsersId}
        LIMIT 1
    </select>

</mapper>
